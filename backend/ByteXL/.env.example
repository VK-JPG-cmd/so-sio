# =============================================================================
# BrandShield AI — Environment Configuration Example (.env.example)
# Copy to .env and adjust variables for your target deployment environment.
# =============================================================================

# Application Settings
APP_NAME="BrandShield AI Backend"
ENVIRONMENT="development"  # Options: development, test, staging, production
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL with asyncpg driver)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="brandshield_ai_dev"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/brandshield_ai_dev"

# CORS Configuration (JSON array or comma-separated list of allowed origin URLs)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# JWT Authentication & Tokens
JWT_SECRET_KEY="brandshield-ai-super-secret-key-for-development-must-be-changed-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="brandshield-ai"
JWT_AUDIENCE="brandshield-users"

# Passwordless OTP Configuration
OTP_PROVIDER="mock"  # Options: mock (in-memory for local dev & automated tests), console (stdout), twilio
OTP_CODE_LENGTH=6
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# External Authoritative DNS Mode
DNS_RESOLVER_MODE="mock"  # Options: mock (in-memory test TXT resolver), live (system/external DNS lookups)

# Twilio SMS Configuration (Required only when OTP_PROVIDER="twilio")
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_FROM_NUMBER="+15550001111"

# Continuous Threat Discovery & Monitoring Worker Settings
THREAT_DISCOVERY_WORKER_ENABLED=false     # Set to true to enable automated background polling loop
THREAT_DISCOVERY_POLL_INTERVAL_SECONDS=300 # Polling cycle interval in seconds (default: 300)
THREAT_DISCOVERY_BATCH_SIZE=50             # Maximum indicators ingested per cycle (default: 50)

# abuse.ch URLhaus Threat Intelligence Connector Settings
URLHAUS_ENABLED=true                      # Enable abuse.ch URLhaus connector
URLHAUS_API_URL="https://urlhaus-api.abuse.ch/v1" # Authoritative base URL
URLHAUS_AUTH_KEY=""                       # Optional Auth-Key from https://urlhaus.abuse.ch/api/
URLHAUS_TIMEOUT_SECONDS=10.0              # Network timeout in seconds
URLHAUS_MAX_RETRIES=3                     # Bounded retries on transient errors

